# Toolchain image for sweeping `pnl install` + EXAMPLES.md of every pnl-packages
# entry on Ubuntu (glibc). pnl is built at run time from the mounted source, so a
# source change needs no image rebuild. binutils is intentionally NOT installed:
# the sweep proves `pnl install` works with libclang as its only external tool.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git \
        build-essential pkg-config cmake perl \
        clang libclang-dev llvm-dev \
        sudo \
        php-cli php-ffi \
    && rm -rf /var/lib/apt/lists/*

# Recent Rust toolchain (Ubuntu's packaged cargo is too old for edition 2024).
ENV RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | CARGO_HOME=/opt/cargo sh -s -- -y --default-toolchain stable --profile minimal

CMD ["bash"]
