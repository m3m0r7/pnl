{
  "name": "m3m0r7/pnl",
  "description": "PHP native-library extension manager: FFI runtime SDK plus the pnl/pnlx CLI built from the bundled Rust sources on install.",
  "type": "composer-plugin",
  "license": "MIT",
  "homepage": "https://github.com/m3m0r7/pnl",
  "autoload": {
    "psr-4": {
      "Pnlx\\": "src/sdk/Pnlx/"
    },
    "files": [
      "src/sdk/Pnlx/Util/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Pnlx\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "composer/composer": "^2.7",
    "phpunit/phpunit": "^12.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  },
  "extra": {
    "class": "Pnlx\\Composer\\Plugin"
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
    "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs:fix": "vendor/bin/php-cs-fixer fix",
    "test": "vendor/bin/phpunit",
    "validate:schemas": "vendor/bin/phpunit --filter SchemaFormatTest"
  },
  "require": {
    "php": ">=8.2",
    "composer-plugin-api": "^2.0",
    "cebe/php-openapi": "^1.8"
  }
}
