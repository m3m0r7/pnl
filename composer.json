{
  "name": "pnl/pnl",
  "description": "PHP native-library extension runtime and generator tests.",
  "type": "project",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Pnlx\\": "src/sdk/Pnlx/"
    },
    "files": [
      "src/sdk/Pnlx/Util/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Pnlx\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs:fix": "vendor/bin/php-cs-fixer fix",
    "test": "vendor/bin/phpunit"
  },
  "require": {
    "cebe/php-openapi": "^1.8"
  }
}
